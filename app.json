{
  "expo": {
    "name": "Yonder",
    "slug": "Yonder",
    "owner": "ayoubghcodings-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yonder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ayoubghcoding.Yonder",
      "infoPlist": {}
    },
    "android": {
      "package": "com.ayoubghcoding.Yonder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f13074",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BricolageGrotesque-Light.ttf",
            "./assets/fonts/BricolageGrotesque-Regular.ttf",
            "./assets/fonts/BricolageGrotesque-Medium.ttf",
            "./assets/fonts/BricolageGrotesque-Semibold.ttf",
            "./assets/fonts/BricolageGrotesque-Bold.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-image",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Yonder uses the microphone to record voice messages."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Yonder uses the camera for selfie verification and profile photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yonder needs your photos so you can add them to your profile.",
          "cameraPermission": "Yonder uses the camera so you can take profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yonder uses your location to show people near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#f13074"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "13cd879e-3786-4ba1-8d40-076841531312"
      }
    }
  }
}
